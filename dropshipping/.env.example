# =============================================================
# DropAgent - Variables de entorno
# Copia este archivo como ".env" y completa tus claves reales.
# NUNCA subas el archivo ".env" a un repositorio público.
# =============================================================

# ---- AliExpress ----
# Credenciales del portal de afiliados / open platform de AliExpress.
# Si no tienes acceso a la API oficial, DropAgent usará scraping
# de las páginas públicas de AliExpress como alternativa.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=dropagent

# Palabras clave separadas por coma usadas para buscar productos trending
ALIEXPRESS_KEYWORDS=gadgets,hogar,fitness,belleza,mascotas

# ---- Shopify ----
# Nombre de tu tienda, ej: mi-tienda.myshopify.com
SHOPIFY_SHOP_URL=
# Token de acceso de una app privada/custom con permisos write_products
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
# Porcentaje de margen aplicado al precio de AliExpress
SHOPIFY_PRICE_MARKUP_PERCENT=45
# Publicar el producto inmediatamente (true) o dejarlo como borrador (false)
SHOPIFY_PUBLISH_IMMEDIATELY=false

# ---- Claude API (Anthropic) ----
# Se usa para generar títulos, descripciones y bullet points de venta
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ---- Facebook Ads ----
# Access token con permisos ads_read / ads_management
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_API_VERSION=v21.0
# Cada cuántas horas se revisa el rendimiento de las campañas
FACEBOOK_MONITOR_INTERVAL_HOURS=24
# Umbrales para marcar un anuncio como "bajo rendimiento"
FACEBOOK_MIN_ROAS=1.5
FACEBOOK_MAX_SPEND_NO_SALES=20

# ---- TikTok Ads ----
# Access token de la TikTok Marketing API (app aprobada + autorización del anunciante)
TIKTOK_ACCESS_TOKEN=
# ID de la cuenta publicitaria (advertiser_id)
TIKTOK_ADVERTISER_ID=
# ID de la "identity" (perfil de TikTok) usada para publicar los anuncios
TIKTOK_IDENTITY_ID=
TIKTOK_IDENTITY_TYPE=CUSTOMIZED_USER
# ID del pixel de TikTok en tu tienda, para medir conversiones (opcional pero recomendado)
TIKTOK_PIXEL_ID=
TIKTOK_API_VERSION=v1.3
# Presupuesto diario (USD) asignado a cada campaña nueva
TIKTOK_DAILY_BUDGET=20
# Objetivo de la campaña: TRAFFIC, CONVERSIONS, PRODUCT_SALES, etc.
TIKTOK_OBJECTIVE_TYPE=TRAFFIC
# Meta de optimización del grupo de anuncios: CLICK, CONVERT, VALUE, etc.
TIKTOK_OPTIMIZATION_GOAL=CLICK
TIKTOK_BID_TYPE=BID_TYPE_NO_BID
TIKTOK_BILLING_EVENT=CPC
# IDs de ubicación geográfica separados por coma (6252001 = Estados Unidos)
TIKTOK_LOCATION_IDS=6252001
# Cada cuántas horas se revisa el ROAS de las campañas
TIKTOK_MONITOR_INTERVAL_HOURS=24
# Umbrales para marcar una campaña como "bajo rendimiento"
TIKTOK_MIN_ROAS=1.5
TIKTOK_MAX_SPEND_NO_SALES=20
# Nombres de las métricas de compras/ingresos en el reporte de TikTok.
# Ajusta estos valores si tu cuenta publicitaria usa nombres distintos.
TIKTOK_PURCHASE_METRIC=conversion
TIKTOK_REVENUE_METRIC=total_purchase_value

# ---- Higgsfield (generación de vídeo publicitario) ----
# API key de tu cuenta de Higgsfield (platform.higgsfield.ai)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=https://platform.higgsfield.ai/v1
# Rutas del endpoint configurables por si la API real difiere de estos
# valores por defecto (documentación sujeta a cambios).
HIGGSFIELD_GENERATE_ENDPOINT=image2video
HIGGSFIELD_STATUS_ENDPOINT=jobs
HIGGSFIELD_MODEL=higgsfield-dit
# Formato de vídeo: 9:16 (TikTok/Reels/Shorts), 16:9, 1:1...
HIGGSFIELD_ASPECT_RATIO=9:16
HIGGSFIELD_VIDEO_DURATION_SECONDS=15
# Frecuencia y tiempo máximo de espera al consultar el estado del job
HIGGSFIELD_POLL_INTERVAL_SECONDS=5
HIGGSFIELD_POLL_TIMEOUT_SECONDS=180
# Carpeta donde se guardan los vídeos generados
HIGGSFIELD_VIDEO_OUTPUT_DIR=generated_videos

# ---- Landing pages ----
# Carpeta donde se guarda cada landing page HTML generada
LANDING_PAGES_OUTPUT_DIR=landing_pages
# Porcentaje de descuento "simulado" mostrado en la landing page
# (precio original = precio final / (1 - descuento))
LANDING_PAGE_DISCOUNT_PERCENT=30
# Stock máximo simulado para el mensaje de urgencia ("Solo quedan X unidades")
LANDING_PAGE_MAX_STOCK=15

# ---- General ----
# Número máximo de productos a procesar por ejecución
MAX_PRODUCTS_PER_RUN=5
# Ruta del archivo donde se guarda el historial de eventos (JSON)
LOG_FILE=log.json
